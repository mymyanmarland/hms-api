generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id
  name           String
  email          String          @unique
  emailVerified  Boolean         @default(false)
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accounts       Account[]
  adminAuditLogs AdminAuditLog[]
  guest          Guest?
  sessions       Session[]
  staff          Staff?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String?

  @@index([email])
  @@index([code])
  @@map("otpCode")
}

/// Emails that are banned from re-registering. Populated when an admin
/// deletes a customer account so the user cannot simply sign in again via
/// the mobile app's auto-signup email-OTP flow. The create-user hook in
/// `lib/auth.ts` rejects any new User whose email is present here.
model BannedEmail {
  id            String   @id @default(cuid())
  email         String   @unique
  reason        String?
  bannedById    String?
  createdAt     DateTime @default(now())
  bannedByStaff Staff?   @relation(fields: [bannedById], references: [id])

  @@map("banned_email")
}

model RoomType {
  id           String   @id @default(uuid())
  name         String
  description  String?
  basePrice    Decimal  @db.Decimal(10, 2)
  maxOccupancy Int      @default(2)
  bedConfig    String?
  amenities    String[]
  images       String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  rooms        Room[]

  @@map("room_type")
}

model Room {
  id                 String              @id @default(uuid())
  number             String              @unique
  floor              Int
  status             RoomStatus          @default(AVAILABLE)
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  roomTypeId         String
  bookingRooms       BookingRoom[]
  digitalKeys        DigitalKey[]
  housekeepingTasks  HousekeepingTask[]
  maintenanceTickets MaintenanceTicket[]
  roomType           RoomType            @relation(fields: [roomTypeId], references: [id])
  statusHistories    RoomStatusHistory[]

  @@index([roomTypeId])
  @@index([status])
  @@map("room")
}

model RoomStatusHistory {
  id        String     @id @default(uuid())
  roomId    String
  status    RoomStatus
  notes     String?
  changedAt DateTime   @default(now())
  changedBy String?
  room      Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([changedAt])
  @@map("room_status_history")
}

model Guest {
  id              String            @id @default(uuid())
  firstName       String
  lastName        String
  email           String            @unique
  phone           String?
  alternatePhone  String?
  dateOfBirth     DateTime?
  nationality     String?
  idType          String?
  idNumber        String?
  idExpiry        DateTime?
  passportCountry String?
  address         String?
  city            String?
  country         String?
  specialRequests String?
  specialNotes    String?
  isVip           Boolean           @default(false)
  loyaltyPoints   Int               @default(0)
  marketingOptIn  Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  userId          String?           @unique
  bookings        Booking[]
  folios          Folio[]
  user            User?             @relation(fields: [userId], references: [id])
  preferences     GuestPreference[]

  @@index([userId])
  @@index([lastName])
  @@map("guest")
}

model GuestPreference {
  id              String   @id @default(uuid())
  guestId         String
  preferenceType  String
  preferenceKey   String
  preferenceValue String
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  guest           Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([guestId, preferenceKey])
  @@index([guestId])
  @@map("guest_preference")
}

model Booking {
  id               String        @id @default(uuid())
  confirmationCode String        @unique
  status           BookingStatus @default(TENTATIVE)
  source           BookingSource @default(DIRECT)
  guestFirstName   String
  guestLastName    String
  guestEmail       String
  guestPhone       String?
  adults           Int           @default(1)
  children         Int           @default(0)
  infants          Int           @default(0)
  subtotal         Decimal       @db.Decimal(10, 2)
  taxes            Decimal       @default(0) @db.Decimal(10, 2)
  discounts        Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount      Decimal       @db.Decimal(10, 2)
  checkInDate      DateTime
  checkOutDate     DateTime
  actualCheckIn    DateTime?
  actualCheckOut   DateTime?
  specialRequests  String?
  internalNotes    String?
  isGroupBooking   Boolean       @default(false)
  groupName        String?
  masterBookingId  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  guestId          String
  groupBookingId   String?
  groupBooking     GroupBooking? @relation("BookingToGroup", fields: [groupBookingId], references: [id])
  guest            Guest         @relation(fields: [guestId], references: [id])
  masterBooking    Booking?      @relation("BookingToMaster", fields: [masterBookingId], references: [id])
  childBookings    Booking[]     @relation("BookingToMaster")
  bookingRooms     BookingRoom[]
  checkIn          CheckIn?
  checkOut         CheckOut?

  @@index([guestId])
  @@index([status])
  @@index([checkInDate])
  @@index([checkOutDate])
  @@index([confirmationCode])
  @@index([masterBookingId])
  @@index([groupBookingId])
  @@map("booking")
}

model BookingRoom {
  id          String   @id @default(uuid())
  bookingId   String
  roomId      String
  rate        Decimal  @db.Decimal(10, 2)
  totalNights Int
  isPrimary   Boolean  @default(true)
  status      String   @default("RESERVED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room        Room     @relation(fields: [roomId], references: [id])

  @@index([bookingId])
  @@index([roomId])
  @@map("booking_room")
}

model GroupBooking {
  id                String    @id @default(uuid())
  groupName         String
  groupType         GroupType
  groupCode         String    @unique
  contactName       String
  contactEmail      String
  contactPhone      String?
  contactCompany    String?
  roomsBlocked      Int       @default(0)
  roomsConfirmed    Int       @default(0)
  discountPercent   Decimal   @default(0) @db.Decimal(5, 2)
  discountNotes     String?
  depositRequired   Boolean   @default(false)
  depositAmount     Decimal?  @db.Decimal(10, 2)
  depositReceived   Decimal   @default(0) @db.Decimal(10, 2)
  depositReceivedAt DateTime?
  depositDueDate    DateTime?
  bookingCutoffDate DateTime?
  releaseDate       DateTime?
  notes             String?
  internalNotes     String?
  arrivalInfo       String?
  departureInfo     String?
  status            String    @default("ACTIVE")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  bookings          Booking[] @relation("BookingToGroup")

  @@index([groupCode])
  @@index([groupType])
  @@index([status])
  @@map("group_booking")
}

model CheckIn {
  id               String    @id @default(uuid())
  bookingId        String    @unique
  checkedInAt      DateTime  @default(now())
  checkedInBy      String
  keyCardNumber    String?
  keyCardIssued    Int       @default(1)
  keyExpiration    DateTime?
  idVerified       Boolean   @default(false)
  idDocumentType   String?
  idDocumentNumber String?
  policiesAccepted Boolean   @default(false)
  privacyAccepted  Boolean   @default(false)
  notes            String?
  booking          Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([checkedInAt])
  @@index([checkedInBy])
  @@index([keyCardNumber])
  @@map("check_in")
}

model CheckOut {
  id                String   @id @default(uuid())
  bookingId         String   @unique
  checkedOutAt      DateTime @default(now())
  checkedOutBy      String
  departureTime     String?
  roomKeysReturned  Boolean  @default(false)
  folioBalance      Decimal  @default(0) @db.Decimal(10, 2)
  paymentRequired   Boolean  @default(false)
  feedbackRequested Boolean  @default(false)
  notes             String?
  booking           Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([checkedOutAt])
  @@index([checkedOutBy])
  @@map("check_out")
}

model DigitalKey {
  id             String    @id @default(uuid())
  keyNumber      String    @unique
  keyCardNumber  String?
  roomId         String
  bookingId      String?
  accessLevel    String    @default("GUEST")
  validFrom      DateTime
  validUntil     DateTime
  maxAccessCount Int?
  accessCount    Int       @default(0)
  lastUsedAt     DateTime?
  status         KeyStatus @default(ACTIVE)
  issuedBy       String?
  issuedAt       DateTime  @default(now())
  revokedAt      DateTime?
  revokedBy      String?
  revokeReason   String?
  notes          String?
  room           Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([bookingId])
  @@index([status])
  @@index([validUntil])
  @@map("digital_key")
}

model HousekeepingTask {
  id           String       @id @default(uuid())
  roomId       String
  taskType     TaskType     @default(CLEANING)
  priority     TaskPriority @default(NORMAL)
  status       TaskStatus   @default(PENDING)
  scheduledFor DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  dueBy        DateTime?
  assignedTo   String?
  instructions String?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  staff        Staff?       @relation(fields: [assignedTo], references: [id])
  room         Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([status])
  @@index([assignedTo])
  @@index([scheduledFor])
  @@map("housekeeping_task")
}

model MaintenanceTicket {
  id          String         @id @default(uuid())
  roomId      String
  category    TicketCategory
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)
  title       String
  description String
  location    String?
  resolution  String?
  resolvedAt  DateTime?
  assignedTo  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  staff       Staff?         @relation(fields: [assignedTo], references: [id])
  room        Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([status])
  @@index([priority])
  @@index([assignedTo])
  @@map("maintenance_ticket")
}

model Folio {
  id            String      @id @default(uuid())
  folioNumber   String      @unique
  status        FolioStatus @default(OPEN)
  guestId       String
  bookingId     String?
  subtotal      Decimal     @default(0) @db.Decimal(10, 2)
  taxes         Decimal     @default(0) @db.Decimal(10, 2)
  totalPayments Decimal     @default(0) @db.Decimal(10, 2)
  balance       Decimal     @default(0) @db.Decimal(10, 2)
  openedAt      DateTime    @default(now())
  closedAt      DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  charges       Charge[]
  guest         Guest       @relation(fields: [guestId], references: [id])
  payments      Payment[]

  @@index([guestId])
  @@index([status])
  @@map("folio")
}

model Charge {
  id            String         @id @default(uuid())
  folioId       String
  category      ChargeCategory
  description   String
  amount        Decimal        @db.Decimal(10, 2)
  quantity      Int            @default(1)
  unitPrice     Decimal?       @db.Decimal(10, 2)
  referenceId   String?
  referenceType String?
  postedBy      String?
  postedAt      DateTime       @default(now())
  nightAuditId  String?
  createdAt     DateTime       @default(now())
  folio         Folio          @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@index([folioId])
  @@index([category])
  @@index([postedAt])
  @@map("charge")
}

model Payment {
  id                String        @id @default(uuid())
  folioId           String
  method            PaymentMethod
  amount            Decimal       @db.Decimal(10, 2)
  transactionId     String?
  authorizationCode String?
  cardLast4         String?
  cardBrand         String?
  reference         String?
  status            String        @default("COMPLETED")
  processedBy       String?
  processedAt       DateTime      @default(now())
  nightAuditId      String?
  refundedAmount    Decimal?      @db.Decimal(10, 2)
  refundedAt        DateTime?
  createdAt         DateTime      @default(now())
  folio             Folio         @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@index([folioId])
  @@index([method])
  @@index([processedAt])
  @@map("payment")
}

model Staff {
  id                  String              @id @default(uuid())
  firstName           String
  lastName            String
  email               String              @unique
  phone               String?
  role                StaffRole           @default(FRONT_DESK)
  isActive            Boolean             @default(true)
  hireDate            DateTime            @default(now())
  salary              Decimal?            @db.Decimal(10, 2)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  userId              String?             @unique
  adminRoleId         String?
  auditActionsTaken   AdminAuditLog[]     @relation("AuditActor")
  auditActionsAgainst AdminAuditLog[]     @relation("AuditTarget")
  emailsBanned        BannedEmail[]
  housekeepingTasks   HousekeepingTask[]
  maintenanceTickets  MaintenanceTicket[]
  shifts              Shift[]
  shiftReports        ShiftReport[]
  adminRole           Role?               @relation(fields: [adminRoleId], references: [id])
  user                User?               @relation(fields: [userId], references: [id])

  @@index([role])
  @@index([isActive])
  @@index([adminRoleId])
  @@map("staff")
}

model Shift {
  id           String        @id @default(uuid())
  staffId      String
  role         StaffRole
  startTime    DateTime
  endTime      DateTime?
  actualStart  DateTime?
  actualEnd    DateTime?
  breakStart   DateTime?
  breakEnd     DateTime?
  status       String        @default("SCHEDULED")
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  staff        Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  shiftReports ShiftReport[]

  @@index([staffId])
  @@index([startTime])
  @@index([status])
  @@map("shift")
}

model ShiftReport {
  id               String   @id @default(uuid())
  shiftId          String
  submittedBy      String
  reportType       String
  totalCharges     Decimal  @default(0) @db.Decimal(12, 2)
  totalPayments    Decimal  @default(0) @db.Decimal(12, 2)
  totalCash        Decimal  @default(0) @db.Decimal(12, 2)
  totalCards       Decimal  @default(0) @db.Decimal(12, 2)
  checkIns         Int      @default(0)
  checkOuts        Int      @default(0)
  noShows          Int      @default(0)
  cancellations    Int      @default(0)
  roomsAvailable   Int      @default(0)
  roomsOccupied    Int      @default(0)
  roomsDirty       Int      @default(0)
  roomsMaintenance Int      @default(0)
  notes            String?
  createdAt        DateTime @default(now())
  shift            Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  staff            Staff    @relation(fields: [submittedBy], references: [id])

  @@index([shiftId])
  @@index([createdAt])
  @@map("shift_report")
}

model EmailLog {
  id           String      @id @default(uuid())
  guestId      String?
  emailType    EmailType
  recipient    String
  subject      String
  body         String?
  templateId   String?
  status       EmailStatus @default(PENDING)
  sentAt       DateTime?
  deliveredAt  DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  errorMessage String?
  metadata     Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([guestId])
  @@index([emailType])
  @@index([status])
  @@index([recipient])
  @@map("email_log")
}

model NightAudit {
  id                 String    @id @default(uuid())
  auditDate          DateTime  @unique @db.Date
  startedAt          DateTime
  completedAt        DateTime?
  status             String    @default("IN_PROGRESS")
  totalRoomRevenue   Decimal   @default(0) @db.Decimal(12, 2)
  totalFbrRevenue    Decimal   @default(0) @db.Decimal(12, 2)
  totalOtherRevenue  Decimal   @default(0) @db.Decimal(12, 2)
  totalRevenue       Decimal   @default(0) @db.Decimal(12, 2)
  totalPayments      Decimal   @default(0) @db.Decimal(12, 2)
  totalRefunds       Decimal   @default(0) @db.Decimal(12, 2)
  totalCheckIns      Int       @default(0)
  totalCheckOuts     Int       @default(0)
  totalOccupiedRooms Int       @default(0)
  occupancyRate      Decimal   @default(0) @db.Decimal(5, 2)
  adr                Decimal   @default(0) @db.Decimal(10, 2)
  revpar             Decimal   @default(0) @db.Decimal(10, 2)
  notes              String?
  preparedBy         String
  reviewedBy         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@map("night_audit")
}

model AdminAuditLog {
  id            String      @id @default(cuid())
  actorStaffId  String?
  targetStaffId String?
  targetUserId  String?
  action        AdminAction
  metadata      Json?
  createdAt     DateTime    @default(now())
  actorStaff    Staff?      @relation("AuditActor", fields: [actorStaffId], references: [id])
  targetStaff   Staff?      @relation("AuditTarget", fields: [targetStaffId], references: [id])
  targetUser    User?       @relation(fields: [targetUserId], references: [id])

  @@index([actorStaffId])
  @@index([targetStaffId])
  @@index([targetUserId])
  @@index([createdAt])
  @@map("admin_audit_log")
}

model Permission {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  resource        String
  action          String
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@index([resource])
  @@index([action])
  @@map("permission")
}

model Role {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  isSuperRole     Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  staff           Staff[]

  @@map("role")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permission")
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  DIRTY
  CLEANING
  MAINTENANCE
  OUT_OF_ORDER
}

enum BookingStatus {
  TENTATIVE
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  DIRECT
  WALK_IN
  PHONE
  OTA
  CORPORATE
  GROUP
}

enum GroupType {
  CORPORATE
  WEDDING
  TOUR
  SPORTS
  GOVERNMENT
  OTHER
}

enum KeyStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  REVOKED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskType {
  CLEANING
  DEEP_CLEANING
  TURNDOWN
  INSPECTION
  STOCKING
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketCategory {
  PLUMBING
  ELECTRICAL
  HVAC
  FURNITURE
  APPLIANCES
  STRUCTURAL
  SECURITY
  OTHER
}

enum FolioStatus {
  OPEN
  CLOSED
  TRANSFERRED
  CANCELLED
}

enum ChargeCategory {
  ROOM
  ROOM_TAX
  FOOD_BEVERAGE
  RESTAURANT
  BAR
  SPA
  MINIBAR
  LAUNDRY
  PARKING
  TRANSPORTATION
  PHONE
  INTERNET
  ENTERTAINMENT
  OTHER
  EARLY_CHECK_IN
  LATE_CHECK_OUT
  PET_FEE
  EXTRA_BED
  CANCELLATION_FEE
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  CORPORATE_ACCOUNT
  GIFT_CARD
  LOYALTY_POINTS
  COMP
}

enum StaffRole {
  ADMIN
  MANAGER
  FRONT_DESK
  CONCIERGE
  HOUSEKEEPING
  MAINTENANCE
  RESTAURANT
  SPA
  ACCOUNTING
}

enum EmailType {
  WELCOME
  BOOKING_CONFIRMATION
  PRE_ARRIVAL
  ARRIVAL_INFO
  CHECK_OUT_REMINDER
  POST_STAY_SURVEY
  MARKETING
  PROMOTIONAL
  BIRTHDAY
  ANNIVERSARY
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
  UNSUBSCRIBED
}

enum AdminAction {
  INVITE
  UPDATE
  DEACTIVATE
  REACTIVATE
  RESET_PASSWORD
  DELETE
  REVOKE_SESSIONS
}
